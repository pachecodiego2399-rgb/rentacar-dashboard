# Credenciales de Airtable — NUNCA se exponen al cliente/navegador,
# solo se usan server-side (API routes).
#
# AIRTABLE_API_KEY: Personal Access Token de Airtable con permisos de
#   lectura Y escritura (data.records:read y data.records:write) sobre la
#   base del cliente. El scope de escritura es necesario porque el
#   dashboard permite cambiar el Estado de un auto desde la interfaz.
#   Se genera en https://airtable.com/create/tokens
AIRTABLE_API_KEY=

# AIRTABLE_BASE_ID: ID de la base (empieza con "app..."), se encuentra
#   en la URL de la base o en la documentación de la API de Airtable.
AIRTABLE_BASE_ID=

# AIRTABLE_TABLE_NAME: nombre exacto de la tabla con los autos.
AIRTABLE_TABLE_NAME=Autos

# AIRTABLE_CLIENTES_TABLE_NAME: nombre exacto de la tabla con los clientes
#   (leads) que gestiona el bot de WhatsApp. Solo lectura desde el
#   dashboard — el estado de cada cliente lo cambia el agente de IA
#   durante la conversación, no Salvador. Si no se define, usa "Clientes".
AIRTABLE_CLIENTES_TABLE_NAME=Clientes
